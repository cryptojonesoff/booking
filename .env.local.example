# Supabase — Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers > API keys (test mode to start)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend — resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# TT marketing site — used by /api/start-checkout to build the success/cancel
# redirect URLs the buyer lands back on (e.g. https://tt-seven-sigma.vercel.app
# or the final custom domain). Must NOT have a trailing slash.
TT_SITE_URL=
